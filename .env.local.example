# Sanity Configuration
# Create a project at https://www.sanity.io/manage and copy these values

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# For preview mode (optional)
# Generate a token at https://www.sanity.io/manage > API > Tokens
SANITY_API_READ_TOKEN=your-read-token

# For seeding gallery images (required for scripts/seed-gallery-sanity.ts)
# Generate a token with Editor or higher permissions
SANITY_API_WRITE_TOKEN=your-write-token

# Preview secret - use any random string
SANITY_PREVIEW_SECRET=your-preview-secret

# Webhook secret for on-demand revalidation (app/api/revalidate/route.ts)
# Generate with: openssl rand -hex 32
# Must also be added to Vercel: vercel env add SANITY_WEBHOOK_SECRET production
SANITY_WEBHOOK_SECRET=your-webhook-secret

# Resend Configuration (for contact form emails)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address to receive contact form submissions
HAUMANSKLOOF_BOOKINGS_EMAIL=bookings@haumanskloof.co.za
HAUMANSKLOOF_INFO_EMAIL=info@haumanskloof.co.za
HAUMANSKLOOF_CONSERVATION_EMAIL=conservation@haumanskloof.co.za


